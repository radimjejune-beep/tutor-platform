# Скопируйте в .env и заполните. Файл .env НЕ коммитится в git.

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# true — если хостинг требует SSL для базы
DB_SSL=false

# Секрет для токенов входа: минимум 32 случайных символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Адреса фронтенда через запятую (для CORS)
FRONTEND_ORIGINS=http://localhost:5173

# Часовой пояс расписания
APP_TIMEZONE=Europe/Moscow

PORT=3001

# ---------- Магазин уроков Lessonfold (сайт, админка /admin, оплата ЮKassa, Telegram-бот) ----------
# Пусто = магазин выключен, платформа работает как раньше.
# Адрес этого бэкенда без слеша на конце: на нём открываются сайт магазина, оферта и личные ссылки на уроки
LF_PUBLIC_URL=
# Токен магазинного бота (@lessonfold_bot). Не путать с TELEGRAM_BOT_TOKEN платформы: это два разных бота.
LF_BOT_TOKEN=
# Ваш Telegram ID для команд админа в боте (узнать: напишите боту /id)
LF_ADMIN_IDS=
LF_SUPPORT_CONTACT=
LF_CHANNEL_URL=
# Первый админ сайта магазина. После первого запуска пароль можно удалить: он сохранён в базе.
LF_ADMIN_LOGIN=radim
LF_ADMIN_PASSWORD=
# ЮKassa: Интеграция → Ключи API. Адрес уведомлений: LF_PUBLIC_URL/api/yookassa
LF_YOOKASSA_SHOP_ID=
LF_YOOKASSA_SECRET_KEY=
# База общая с платформой (DATABASE_URL), таблицы магазина в отдельной схеме lessonfold
