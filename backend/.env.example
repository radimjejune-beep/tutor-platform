# Скопируйте в .env и заполните. Файл .env НЕ коммитится в git.

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# true — если хостинг требует SSL для базы
DB_SSL=false

# Секрет для токенов входа: минимум 32 случайных символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Адреса фронтенда через запятую (для CORS)
FRONTEND_ORIGINS=http://localhost:5173

# Часовой пояс расписания
APP_TIMEZONE=Europe/Moscow

PORT=3001
